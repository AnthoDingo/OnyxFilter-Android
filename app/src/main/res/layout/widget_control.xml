<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4 × 2 (ProtectionControlWidget). Contenu par défaut : aperçu dans le sélecteur de widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_enabled"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_shield_check" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/protection_enabled"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/protection_enabled_description"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_action_10_min"
            style="@style/OnyxWidgetButton"
            android:contentDescription="@string/widget_cd_disable_10_min"
            android:text="@string/widget_duration_10_min" />

        <TextView
            android:id="@+id/widget_action_1_h"
            style="@style/OnyxWidgetButton"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_cd_disable_1_h"
            android:text="@string/widget_duration_1_h" />

        <TextView
            android:id="@+id/widget_action_tomorrow"
            style="@style/OnyxWidgetButton"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_cd_disable_tomorrow"
            android:text="@string/widget_duration_tomorrow" />

        <TextView
            android:id="@+id/widget_action_primary"
            style="@style/OnyxWidgetButton.Primary"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_disable"
            android:text="@string/widget_disable" />
    </LinearLayout>
</LinearLayout>
