<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4 × 2 (StatsActivityWidget). Les marges horizontales (padding) sont reprises par
     StatsWidgets.ACTIVITY_HORIZONTAL_PADDING_DP pour la largeur de l'histogramme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_neutral"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/stats_activity_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stats_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:id="@+id/stats_refresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/stats_refresh"
                android:padding="4dp"
                android:src="@drawable/ic_widget_refresh" />

            <ProgressBar
                android:id="@+id/stats_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stats_values"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stats_total"
                    style="@style/OnyxWidgetKpiValue"
                    android:text="@string/stats_preview_total" />

                <TextView
                    style="@style/OnyxWidgetKpiLabel"
                    android:text="@string/stats_label_queries" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stats_blocked"
                    style="@style/OnyxWidgetKpiValue"
                    android:text="@string/stats_preview_blocked" />

                <TextView
                    style="@style/OnyxWidgetKpiLabel"
                    android:text="@string/stats_label_blocked" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stats_ratio"
                    style="@style/OnyxWidgetKpiValue"
                    android:text="@string/stats_preview_ratio" />

                <TextView
                    style="@style/OnyxWidgetKpiLabel"
                    android:text="@string/stats_label_ratio" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:minHeight="24dp">

            <!-- Requêtes par heure (une série, sans légende : le titre la nomme). -->
            <ImageView
                android:id="@+id/stats_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/stats_chart_empty"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/stats_chart_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/stats_chart_empty"
                android:textColor="@color/widget_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Ligne de base, discrète : un trait fin dans la couleur de la grille. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:src="@color/widget_chart_grid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/stats_axis_start"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/stats_axis_end"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
