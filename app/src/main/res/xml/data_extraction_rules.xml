<?xml version="1.0" encoding="utf-8"?>
<!-- Les jetons sont chiffrés avec une clé de l'Android Keystore, propre à l'appareil : les sauvegarder
     ou les transférer vers un autre appareil n'a pas de sens. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
