<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis : actualisation toutes les 30 minutes (minimum autorisé), pour refléter les
     changements faits depuis l'interface web. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_toggle_description"
    android:initialLayout="@layout/widget_toggle"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewImage="@drawable/ic_shield_check"
    android:previewLayout="@layout/widget_toggle"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
